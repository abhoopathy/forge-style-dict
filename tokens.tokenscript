// ============================================================
// COLOR MODES / DEFAULT
// ============================================================

Color
  Primary
    500 = $Color.Blue.500
    /colorScale : lch
      base = $Color.Primary.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Primary.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  Secondary
    500 = $Color.Yellow.500
    /colorScale : lch
      base = $Color.Secondary.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Secondary.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  Tertiary
    500 = $Color.Red.500
    /colorScale : lch
      base = $Color.Tertiary.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Tertiary.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  Base
    0    = white
    10   = #F8FBFC
    25   = colorMix($Color.Blue.500, $Color.Base.10, 90, lch)
    50   = colorMix($Color.Blue.500, $Color.Base.10, 80, lch)
    100  = colorMix($Color.Blue.500, $Color.Base.10, 60, lch)
    200  = colorMix($Color.Base.500, $Color.Base.10, 40, lch)
    300  = colorMix($Color.Blue.500, $Color.Base.10, 20, lch)
    400  = colorMix($Color.Blue.500, $Color.Base.10, 10, lch)
    500  = $Color.Primary.500
    600  = colorMix($Color.Base.500, black, 20, lch)
    700  = colorMix($Color.Base.500, black, 40, lch)
    800  = colorMix($Color.Base.500, black, 60, lch)
    900  = colorMix($Color.Base.500, black, 80, lch)
    950  = colorMix($Color.Base.500, black, 90, lch)
    1000 = black

  Text
    Normal       = $Color.Base.900
    Muted        = $Color.Base.300
    Faint        = $Color.Base.200
    On-Accent    = $Color.Base.0
    Positive     = $Color.Green.700
    Negative     = $Color.Red.600
    Warning      = $Color.Yellow.600
    Accent       = $Color.Tertiary.500
    Heading      = $Color.Primary.500
    Accent-Hover = $Color.Secondary.500

  Background
    Primary        = $Color.Base.0
    Primary-Alt    = $Color.Base.10
    Secondary      = $Color.Secondary.50
    Secondary-Alt  = $Color.Secondary.100
    Hover          = $Color.Base.300
    Active-Hover   = $Color.Base.300
    Border         = $Color.Base.50
    Border-Hover   = $Color.Base.400
    Border-Focus   = $Color.Yellow.500
    Negative       = $Color.Red.200
    Warning        = $Color.Yellow.200
    Positive       = $Color.Green.200
    Form-Field     = $Color.Base.25
    Message        = $Color.Base.300
    Accent         = $Color.Secondary.500

  Interactive
    Normal       = $Color.Base.500
    Accent       = $Color.Secondary.500
    Hover        = $Color.Base.400
    Accent-Hover = $Color.Secondary.400

Component-Colors
  Callouts
    callout-bg = $Color.Background.Secondary
  Tables
    table-bg = $Color.Background.Secondary
  Annotations
    annotation-stroke-color = $Color.Red.500
  Scrims
    bg-scrim = colorMix($Color.Base.800, transparent, 70, lch)
  Figma
    figma-section-bg     = $Color.Secondary.100
    figma-section-bg-alt = $Color.Secondary.50
    figma-page-bg        = $Color.Base.0

// ============================================================
// MEDIA QUERIES (viewport/grid tokens per breakpoint)
// ============================================================

Media
  Desktop
    Document            = "Desktop"
    viewport-width      = 1512
    viewport-height     = 982
    grid-cols           = 12
    grid-gutter         = 24
    col-width           = 80
    row-height          = $Media.Desktop.col-width
    grid-rows           = 100000000
    margin-bottom       = 0
    margin-top          = 0
    container-width     = $Media.Desktop.col-width * $Media.Desktop.grid-cols + ($Media.Desktop.grid-cols - 1) * $Media.Desktop.grid-gutter
    margin-left         = ($Media.Desktop.viewport-width - $Media.Desktop.container-width) / 2
    margin-right        = $Media.Desktop.margin-left
    paragraph-max-width = $toSet.baseTextSize * 30
    Width
      w-1_2   = ($Media.Desktop.container-width - ($Media.Desktop.grid-gutter * (2 - 1))) / 2
      w-1_3   = ($Media.Desktop.container-width - ($Media.Desktop.grid-gutter * (3 - 1))) / 3
      w-1_4   = ($Media.Desktop.container-width - ($Media.Desktop.grid-gutter * (4 - 1))) / 4
      w-3_4   = ($Media.Desktop.container-width - $Media.Desktop.grid-gutter) / 3
      w-1_5   = ($Media.Desktop.container-width - ($Media.Desktop.grid-gutter * (5 - 1))) / 5
      w-1_6   = ($Media.Desktop.container-width - ($Media.Desktop.grid-gutter * (6 - 1))) / 6
      w-100vw = $Media.Desktop.viewport-width
      w-50vw  = $Media.Desktop.viewport-width / 2
      w-33vw  = $Media.Desktop.viewport-width / 4
      w-25vw  = $Media.Desktop.viewport-width / 4
    Height
      h-100vh = $Media.Desktop.viewport-height
      h-90vh  = $Media.Desktop.viewport-height * 0.9
      h-80vh  = $Media.Desktop.viewport-height * 0.8
      h-70vh  = $Media.Desktop.viewport-height * 0.7
      h-60vh  = $Media.Desktop.viewport-height * 0.6
      h-50vh  = $Media.Desktop.viewport-height / 2
      h-40vh  = $Media.Desktop.viewport-height * 0.4
      h-30vh  = $Media.Desktop.viewport-height * 0.3
      h-20vh  = $Media.Desktop.viewport-height * 0.2
      h-10vh  = $Media.Desktop.viewport-height * 0.1
      h-33vh  = $Media.Desktop.viewport-height / 3
      h-66vh  = $Media.Desktop.viewport-height * (2 / 3)
      h-25vh  = $Media.Desktop.viewport-height / 4
      h-75vh  = $Media.Desktop.viewport-height * (3 / 4)

