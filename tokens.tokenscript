// ============================================================
// PRIMITIVES / DEFAULT
// ============================================================

// --- Spacing Scale ---
// Scale.0 = 0, Scale.1 = 3 are manual anchors
// Scale.2–10 double each step (modular, ratio 2, base 6)
// Scale.4p5–10p5 are 1.5x half-steps (modular, ratio 2, base 36)
Scale
  0 = 0
  1 = 3
  /numberScale : modular
    base = 6
    ratio = 2
    steps = [{2..10}]
  /numberScale : modular
    base = 36
    ratio = 2
    steps = [{4..10}p5]

// --- Color Palettes ---

Color
  // Green: base #036d01, light shades via colorScale, dark shades via colorScale
  Green
    500 = #036d01
    /colorScale : lch
      base = $Color.Green.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Green.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  // Orange: base #FE9901
  Orange
    500 = #FE9901
    /colorScale : lch
      base = $Color.Orange.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Orange.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  // Yellow: base #FFAD00
  Yellow
    500 = #FFAD00
    /colorScale : lch
      base = $Color.Yellow.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Yellow.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  // Red: base #F1140C
  Red
    500 = #F1140C
    /colorScale : lch
      base = $Color.Red.500
      steps = [25, 50, 100, 200, 300, 400]
      lightness = stops(98, 96, 92, 84, 72, 60)
    /colorScale : lch
      base = $Color.Red.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  // Blue: mixed toward #F8F8FC for light shades, darkened for dark shades
  Blue
    500 = #1700AE
    /colorMix : lch
      base = $Color.Blue.500
      target = #F8F8FC
      steps = [25, 50, 100, 200, 300, 400]
      ratio = stops(90, 80, 60, 40, 20, 10)
    /colorScale : lch
      base = $Color.Blue.500
      steps = [600, 700, 800, 900, 950]
      lightness = stops(24, 18, 12, 6, 3)

  // Transparent Dark: Color.Blue.900 at varying alpha
  Transparent-Dark
    1000 = $Color.Blue.900
    /colorMix : lch
      base = $Color.Transparent-Dark.1000
      target = transparent
      steps = [0, 10, 25, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950, 980]
      ratio = stops(100, 99, 97.5, 90, 80, 70, 60, 50, 40, 30, 20, 10, 5, 2)

  // Transparent Light: Color.Blue.50 at varying alpha
  Transparent-Light
    1000 = $Color.Blue.50
    /colorMix : lch
      base = $Color.Transparent-Light.1000
      target = transparent
      steps = [0, 10, 25, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950, 980]
      ratio = stops(100, 99, 97.5, 90, 80, 70, 60, 50, 40, 30, 20, 10, 5, 2)

// --- Type Scale Ratios ---
TypeScale
  GoldenRatio     = 1.618
  MajorSecond     = 1.125
  MinorThird      = 1.2
  PerfectFourth   = 1.333
  AugmentedFourth = 1.414

// --- Configurable settings ---
toSet
  typeScale    = $TypeScale.PerfectFourth
  baseTextSize = 18

// ============================================================
// DESIGN TOKENS / DEFAULT
// ============================================================

// --- Font Families ---
fontFamilies
  body    = "Empirica Text"
  heading = "Union Gothic"
  accent  = "Union Gothic"
  ui      = "Union Gothic"

// --- Font Weights ---
fontWeights
  body
    100 = "Regular"
    200 = "Regular"
    300 = "Regular"
    400 = "Regular"
    500 = "Regular"
    600 = "Bold"
    700 = "Bold"
    800 = "Bold"
    900 = "Bold"
  heading
    100 = "ZohranWeight"
    200 = "ZohranWeight"
    300 = "ZohranWeight"
    400 = "ZohranWeight"
    500 = "ZohranWeight"
    600 = "ZohranWeight"
    700 = "ZohranWeight"
    800 = "ZohranWeight"
    900 = "ZohranWeight"
  accent
    100 = "Black"
    200 = "Black"
    300 = "Black"
    400 = "Black"
    500 = "Regular"
    600 = "Black"
    700 = "Black"
    800 = "Black"
    900 = "Black"
  ui
    100 = "Regular"
    200 = "Regular"
    300 = "Regular"
    400 = "Bold"
    500 = "Bold"
    600 = "Black"
    700 = "Black"
    800 = "Black"
    900 = "Black"

// --- Paragraph Indent ---
paragraphIndent
  0 = "0px"

// --- Sizes (aliases into Scale) ---
sizes
  none = $Scale.0
  xs   = $Scale.1
  sm   = $Scale.2
  md   = $Scale.3
  lg   = $Scale.4
  xl   = $Scale.4p5
  2xl  = $Scale.5
  3xl  = $Scale.5p5
  4xl  = $Scale.6
  5xl  = $Scale.6p5

// --- Font Size Scale ---
// Step 5 = base (18); steps 6–15 go up by typeScale ratio; steps 1–4 go down
fontSize
  0  = 9
  5  = $toSet.baseTextSize
  4  = $fontSize.5 / $toSet.typeScale
  3  = $fontSize.4 / $toSet.typeScale
  2  = $fontSize.3 / $toSet.typeScale
  1  = $fontSize.2 / $toSet.typeScale
  6  = $fontSize.5 * $toSet.typeScale
  7  = $fontSize.6 * $toSet.typeScale
  8  = $fontSize.7 * $toSet.typeScale
  9  = $fontSize.8 * $toSet.typeScale
  10 = $fontSize.9 * $toSet.typeScale
  11 = $fontSize.10 * $toSet.typeScale
  12 = $fontSize.11 * $toSet.typeScale
  13 = $fontSize.12 * $toSet.typeScale
  14 = $fontSize.13 * $toSet.typeScale
  15 = $fontSize.14 * $toSet.typeScale

// --- Line Heights ---
lineHeights
  leading-normal   = "140%"
  leading-tight    = "118%"
  leading-tighter  = "109%"
  leading-tightest = "100%"

// --- Letter Spacing ---
letterSpacing
  tracking-normal  = "0"
  tracking-tight   = "-1%"
  tracking-tighter = "-3%"
  tracking-wide    = "5%"

// --- Text Case / Decoration ---
textCase
  none      = "none"
  uppercase = "uppercase"

textDecoration
  none = "none"

// --- Border Radius ---
borderRadius
  border-radius-sm      = $Scale.1
  border-radius-md      = $Scale.2
  border-radius-lg      = $Scale.3
  border-radius-xl      = $Scale.4
  border-radius-2xl     = $Scale.5
  border-radius-rounded = 100000000

// --- Shadows ---
shadow-1
  x      = 0
  y      = 1
  blur   = 2
  spread = 0
  color  = $Color.Transparent-Dark.100

shadow-2
  x      = 0
  y      = 2
  blur   = 3
  spread = 0
  color  = $Color.Transparent-Dark.100

shadow-3
  x      = 0
  y      = 4
  blur   = 4
  spread = 0
  color  = $Color.Transparent-Dark.100

shadow-4
  x      = 0
  y      = 6
  blur   = 6
  spread = 0
  color  = $Color.Transparent-Dark.200

shadow-5
  x      = 0
  y      = 8
  blur   = 14
  spread = 0
  color  = $Color.Transparent-Dark.300

shadow-6
  x      = 0
  y      = 16
  blur   = 16
  spread = 0
  color  = $Color.Transparent-Dark.400

// --- Component Tokens ---
Component-Tokens
  Annotation-Stroke-Width = 1

// --- Typography: heading ---
heading
  xs
    fontFamily       = $fontFamilies.heading
    fontWeight       = $fontWeights.heading.500
    lineHeight       = $lineHeights.leading-tightest
    fontSize         = $fontSize.3
    letterSpacing    = $letterSpacing.tracking-tight
    paragraphSpacing = $sizes.sm
    paragraphIndent  = $paragraphIndent.0
    textCase         = $textCase.none
    textDecoration   = $textDecoration.none
