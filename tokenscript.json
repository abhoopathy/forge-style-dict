{
"spacing": {
  "base": {
    "$type": "dimension",
    "$value": "8px"
  },
  "large": {
    "$type": "dimension",
    "$value": "{spacing.base} * 2"
  },
  "xlarge": {
    "$type": "dimension",
    "$value": "{spacing.large} * 1.5"
  }
},
"colors": {
  "primary": {
    "$type": "color",
    "$value": "#0066FF"
  },
  "darkPrimary": {
    "$type": "color",
    "$value": "invert({colors.primary}).to.hex()"
  }
}
}
